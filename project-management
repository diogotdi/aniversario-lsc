  drawPriorityChart(h, m, l) {
    const canvas = $('#priorityChart');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const dpr = window.devicePixelRatio || 1;
    const rect = canvas.getBoundingClientRect();
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    ctx.scale(dpr, dpr);

    const total = h+m+l || 1;
    const cx = rect.width/2, cy = rect.height/2, r = Math.min(cx,cy)-20;
    const data = [{v:h,c:'#DE350B',l:'High'},{v:m,c:'#FF8B00',l:'Medium'},{v:l,c:'#00875A',l:'Low'}];

    let start = -Math.PI/2;
    data.forEach(d => {
      const angle = (d.v/total)*Math.PI*2;
      ctx.beginPath();
      ctx.moveTo(cx,cy);
      ctx.arc(cx,cy,r,start,start+angle);
      ctx.closePath();
      ctx.fillStyle=d.c;
      ctx.fill();
      start+=angle;
    });
    // Center hole
    ctx.beginPath();
    ctx.arc(cx,cy,r*0.55,0,Math.PI*2);
    ctx.fillStyle=getComputedStyle(document.documentElement).getPropertyValue('--surface').trim();
    ctx.fill();
    // Center text
    ctx.fillStyle=getComputedStyle(document.documentElement).getPropertyValue('--text').trim();
    ctx.font='bold 18px '+getComputedStyle(document.body).fontFamily;
    ctx.textAlign='center';
    ctx.textBaseline='middle';
    ctx.fillText(total+' open',cx,cy);

    // Legend
    let lx = 10, ly = rect.height - 16;
    data.forEach(d => {
      ctx.fillStyle=d.c; ctx.fillRect(lx,ly,10,10); ctx.fillStyle=getComputedStyle(document.documentElement).getPropertyValue('--text').trim();
      ctx.font='11px '+getComputedStyle(document.body).fontFamily; ctx.textAlign='left'; ctx.textBaseline='middle';
      ctx.fillText(`${d.l}: ${d.v}`,lx+14,ly+5); lx+=80;
    });
  }
};

