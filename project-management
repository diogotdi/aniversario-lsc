const CSVModule = {
  showModal() {
    Modal.open('📥 Import / Export CSV', `
      <div class="detail-section"><div class="detail-section-title">Export</div>
        <p style="font-size:0.78rem;color:var(--text-secondary);margin-bottom:8px">Download all tasks as CSV (Asana-compatible format)</p>
        <button class="btn btn-primary btn-block" onclick="CSVModule.exportCSV()">📤 Export CSV</button></div>
      <div class="detail-section"><div class="detail-section-title">Import</div>
        <p style="font-size:0.78rem;color:var(--text-secondary);margin-bottom:8px">Import tasks from CSV. Format: Section, Task Name, Due Date, Priority, Tags</p>
        <input type="file" accept=".csv" class="form-input" onchange="CSVModule.importCSV(this.files[0])"></div>
    `);
  },
  exportCSV() {
    const rows = [['Section','Task Name','Due Date','Priority','Tags','Status','Assignee','Start Date']];
    Store.tasks.forEach(t => {
      const sec = Store.getSection(t.sectionId);
      const person = t.assignee ? Store.getPerson(t.assignee) : null;
      rows.push([sec?.name||'',t.name,t.dueDate||'',t.priority,(t.tags||[]).join(';'),t.status,person?.name||'',t.startDate||'']);
    });
    const csv = rows.map(r=>r.map(c=>`"${String(c).replace(/"/g,'""')}"`).join(',')).join('\n');
    const blob = new Blob([csv],{type:'text/csv;charset=utf-8;'});
    const a = document.createElement('a'); a.href=URL.createObjectURL(blob); a.download='leixoes-119-tasks.csv'; a.click();
    showToast('📤 CSV exported');
  },
  importCSV(file) {
    if (!file) return;
    const reader = new FileReader();
    reader.onload = e => {
      const lines = e.target.result.split('\n').filter(l=>l.trim());
      if (lines.length < 2) { showToast('Empty CSV'); return; }
      let imported = 0;
      // Skip header
      for (let i=1; i<lines.length; i++) {
        const cols = lines[i].match(/("([^"]|"")*"|[^,]*)/g)?.map(c=>c.replace(/^"|"$/g,'').replace(/""/g,'"').trim()) || [];
        if (cols.length < 2 || !cols[1]) continue;
        const secName = cols[0]||'';
        const section = Store.sections.find(s=>s.name.toLowerCase().includes(secName.toLowerCase())) || Store.sections[0];
        Store.addTask({
          sectionId: section.id,
          name: cols[1],
          dueDate: cols[2]||'',
          priority: cols[3]||'Medium',
          tags: (cols[4]||'').split(';').filter(Boolean),
          startDate: cols[7]||'',
        });
        imported++;
      }
      Modal.close();
      TaskList.render();
      showToast(`📥 ${imported} tasks imported`);
    };
    reader.readAsText(file);
  }
};

// ================================================
// DARK MODE
// ================================================
const Theme = {
  init() {
    const saved = localStorage.getItem('leixoes-theme');
    if (saved) { document.documentElement.setAttribute('data-theme', saved); }
    else if (window.matchMedia('(prefers-color-scheme: dark)').matches) { document.documentElement.setAttribute('data-theme', 'dark'); }
    this.updateIcon();
  },
  toggle() {
    const current = document.documentElement.getAttribute('data-theme');
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.classList.add('theme-transition');
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('leixoes-theme', next);
    this.updateIcon();
    setTimeout(() => document.documentElement.classList.remove('theme-transition'), 400);
  },
  updateIcon() {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    $('#themeToggle').textContent = isDark ? '☀️' : '🌙';
  }
};

// ================================================
// KEYBOARD SHORTCUTS
// ================================================
const Shortcuts = {
  init() {
    document.addEventListener('keydown', e => {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT') return;
      const key = e.key.toLowerCase();

      if (key === 'n') { e.preventDefault(); TaskModal.open(); this.hint('N → New Task'); }
      else if (key === 'd') { e.preventDefault(); App.toggleTheme(); this.hint('D → Toggle Dark Mode'); }
      else if (key === '1') { Nav.go('dashboard'); this.hint('1 → Dashboard'); }
      else if (key === '2') { Nav.go('tasks'); this.hint('2 → Tasks'); }
      else if (key === '3') { Nav.go('gantt'); this.hint('3 → Gantt'); }
      else if (key === '4') { Nav.go('calendar'); this.hint('4 → Calendar'); }
      else if (key === '5') { Nav.go('files'); this.hint('5 → Files'); }
      else if (key === '?' || (e.shiftKey && key === '/')) { e.preventDefault(); App.showShortcuts(); }
      else if (e.ctrlKey && key === 'k') { e.preventDefault(); Nav.go('tasks'); setTimeout(()=>$('#taskSearch')?.focus(),100); this.hint('Ctrl+K → Search'); }
      else if (key === 'escape') { Modal.close(); BulkActions.clearSelection(); }
    });
  },
  hint(msg) {
    const el = $('#kbdHint');
    el.textContent = msg;
    el.classList.add('show');
    clearTimeout(this._timer);
    this._timer = setTimeout(() => el.classList.remove('show'), 1500);
  }
};

// ================================================
// NOTIFICATIONS
// ================================================
const Notifications = {
  init() {
    if ('Notification' in window && Notification.permission === 'default') {
      // Don't auto-ask; user can trigger via dashboard
    }
    this.check();
    setInterval(() => this.check(), 3600000); // Every hour
  },
  async requestPermission() {
    if (!('Notification' in window)) { showToast('Notifications not supported'); return; }
    const perm = await Notification.requestPermission();
    if (perm === 'granted') { showToast('🔔 Notifications enabled'); this.check(); }
    else showToast('Notifications blocked');
  },
  check() {
    if (!('Notification' in window) || Notification.permission !== 'granted') return;
    const today = new Date().toISOString().slice(0,10);
    const tomorrow = new Date(Date.now()+dayMs).toISOString().slice(0,10);
    const overdue = Store.tasks.filter(t => isOverdue(t.dueDate, t.status));
    const dueTomorrow = Store.tasks.filter(t => t.dueDate === tomorrow && t.status !== 'Done');

    if (overdue.length > 0) {
      new Notification('⚠️ Leixões PM: Overdue Tasks', { body: `${overdue.length} task(s) are past due`, icon: '📋', tag: 'overdue' });
    }
    if (dueTomorrow.length > 0) {
      new Notification('📅 Leixões PM: Due Tomorrow', { body: `${dueTomorrow.length} task(s) due tomorrow`, icon: '📅', tag: 'upcoming' });
    }
  },
  updateBadge() {
    const od = Store.tasks.filter(t => isOverdue(t.dueDate, t.status)).length;
    const b = $('#overdueBadge');
    if (od > 0) { b.style.display='flex'; b.textContent=od; } else b.style.display='none';
  }
};

