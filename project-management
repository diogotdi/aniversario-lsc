// ================================================
const DragDrop = {
  dragId: null,
  start(e, id) { this.dragId = id; e.dataTransfer.effectAllowed = 'move'; e.target.classList.add('dragging'); },
  over(e) { e.preventDefault(); e.dataTransfer.dropEffect = 'move'; },
  drop(e, targetId, sectionId) {
    e.preventDefault();
    if (!this.dragId || this.dragId === targetId) return;
    Store.moveTask(this.dragId, targetId, sectionId);
    this.dragId = null;
    TaskList.render();
    showToast('Task reordered');
  }
};
document.addEventListener('dragend', () => { $$('.dragging').forEach(el=>el.classList.remove('dragging')); DragDrop.dragId = null; });

