        <div class="detail-field"><div class="detail-field-label">Event Dates</div><div class="detail-field-value">27-28 Nov 2026</div></div>
        <div class="detail-field"><div class="detail-field-label">Location</div><div class="detail-field-value">Fábrica Vasco da Gama</div></div>
