// ================================================
// GANTT CHART WITH DEPENDENCY ARROWS
// ================================================
const Gantt = {
  filterSection: '',
  render() {
    this.renderControls();
    this.renderChart();
  },
  renderControls() {
    let html = `<div class="filter-chip${!this.filterSection?' active':''}" onclick="Gantt.filterSection='';Gantt.render()">All</div>`;
    Store.sections.forEach(s => {
      html += `<div class="filter-chip${this.filterSection===s.id?' active':''}" onclick="Gantt.filterSection='${s.id}';Gantt.render()" style="${this.filterSection===s.id?'background:'+s.color+';color:white;border-color:'+s.color:''}">${s.name}</div>`;
    });
    $('#ganttControls').innerHTML = html;
  },
  renderChart() {
    const tasks = Store.tasks.filter(t => {
      if (this.filterSection && t.sectionId !== this.filterSection) return false;
      return t.dueDate;
    });
    if (!tasks.length) { $('#ganttContainer').innerHTML='<div class="empty-state"><div class="empty-state-icon">📊</div><div class="empty-state-title">No tasks</div></div>'; return; }

    const allDates = tasks.flatMap(t=>[t.startDate,t.dueDate].filter(Boolean)).map(d=>new Date(d));
    const minDate = new Date(Math.min(...allDates)); minDate.setDate(minDate.getDate()-3);
    const maxDate = new Date(Math.max(...allDates)); maxDate.setDate(maxDate.getDate()+7);
    const totalDays = daysBetween(minDate, maxDate);
    const dayW = 28, labelW = 200;
    const today = new Date().toISOString().slice(0,10);

    let headerHtml = '';
    for (let i=0; i<totalDays; i++) {
      const d = new Date(minDate.getTime()+i*dayMs);
      const iso = d.toISOString().slice(0,10);
      const dow = d.getDay();
      headerHtml += `<div class="gantt-day${dow===0||dow===6?' weekend':''}${iso===today?' today':''}">${d.getDate()}</div>`;
    }

    const grouped = Store.getTasksBySection();
    let rowsHtml = '';
    let rowIdx = 0;
    const taskPos = {};
    const visibleSections = this.filterSection ? [Store.getSection(this.filterSection)] : Store.sections;

    visibleSections.forEach(section => {
      const st = (grouped[section.id]?.tasks||[]).filter(t=>t.dueDate).sort((a,b)=>(a.startDate||a.dueDate).localeCompare(b.startDate||b.dueDate));
      if (!st.length) return;
      rowsHtml += `<div class="gantt-row gantt-row-section"><div class="gantt-label-col">${section.name}</div><div class="gantt-bars" style="background:var(--bg)"></div></div>`;
      rowIdx++;
      st.forEach(t => {
        const sd = t.startDate||t.dueDate, ed = t.dueDate;
        const so = daysBetween(minDate, new Date(sd));
        const dur = Math.max(1, daysBetween(new Date(sd), new Date(ed))+1);
        const left = so*dayW, width = dur*dayW-2;
        let col = section.color;
        if (t.status==='Done') col='#00875A'; else if (isOverdue(t.dueDate,t.status)) col='#DE350B';
        const cls = t.isMilestone&&!t.isGate?'gantt-bar milestone':'gantt-bar';
        taskPos[t.id] = { row:rowIdx, left:left, right:left+width, cx:left+width/2, cy:rowIdx*28+14 };
        rowsHtml += `<div class="gantt-row" data-taskid="${t.id}"><div class="gantt-label-col" onclick="TaskDetail.open('${t.id}')"><span class="priority-dot ${t.priority.toLowerCase()}" style="margin-right:3px"></span>${escHtml(t.name)}</div><div class="gantt-bars"><div class="${cls}" style="left:${left}px;width:${width}px;background:${col}" title="${t.name}\n${formatDate(sd)}→${formatDate(ed)}" onclick="TaskDetail.open('${t.id}')" data-taskid="${t.id}"
        onmouseenter="Gantt.highlightDeps('${t.id}',true)" onmouseleave="Gantt.highlightDeps('${t.id}',false)"></div></div></div>`;
        rowIdx++;
      });
    });

    // Build SVG dependency arrows
    let svgPaths = '';
    const totalH = (rowIdx+1)*28;
    Store.tasks.forEach(t => {
      (t.dependencies||[]).forEach(depId => {
        const from = taskPos[depId], to = taskPos[t.id];
        if (!from || !to) return;
        const x1 = from.right, y1 = from.cy;
        const x2 = to.left, y2 = to.cy;
        const mx = x1 + (x2-x1)*0.5;
        svgPaths += `<path d="M${x1},${y1} C${mx},${y1} ${mx},${y2} ${x2},${y2}" data-from="${depId}" data-to="${t.id}"/>`;
      });
    });

    const todayOff = daysBetween(minDate, new Date(today));
    const todayLeft = todayOff*dayW + dayW/2;

    $('#ganttContainer').innerHTML = `<div style="min-width:${labelW+totalDays*dayW}px;position:relative">
      <div class="gantt-header-row"><div class="gantt-label-col">Task</div><div class="gantt-timeline" style="display:flex">${headerHtml}</div></div>
      ${rowsHtml}
      <svg class="gantt-dep-svg" width="${totalDays*dayW}" height="${totalH}">
        <defs><marker id="arrow" markerWidth="6" markerHeight="4" refX="6" refY="2" orient="auto"><path d="M0,0 L6,2 L0,4 Z" fill="var(--text-light)"/></marker></defs>
        ${svgPaths}
      </svg>
      <div class="gantt-today-line" style="left:${labelW+todayLeft}px;height:${totalH}px"></div>
    </div>`;
  },

  highlightDeps(taskId, on) {
    $$('.gantt-dep-svg path').forEach(p => {
      if (p.dataset.from===taskId || p.dataset.to===taskId) p.classList.toggle('highlight', on);
    });
  }
};

