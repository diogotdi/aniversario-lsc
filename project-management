// APP
// ================================================
const App = {
  toggleTheme() { Theme.toggle(); if(Nav.current==='dashboard')Dashboard.render(); },
  exportJSON() {
    const blob = new Blob([JSON.stringify(Store.data,null,2)],{type:'application/json'});
    const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='leixoes-pm-backup.json';a.click();
    showToast('💾 JSON exported');
  },
  showCSVModal() { CSVModule.showModal(); },
  showShortcuts() {
    Modal.open('⌨️ Keyboard Shortcuts', `
      <div style="display:grid;grid-template-columns:80px 1fr;gap:6px;font-size:0.82rem">
        <kbd>N</kbd><span>New task</span>
        <kbd>D</kbd><span>Toggle dark mode</span>
        <kbd>1-5</kbd><span>Switch view</span>
        <kbd>Ctrl+K</kbd><span>Search tasks</span>
        <kbd>?</kbd><span>Show shortcuts</span>
        <kbd>Esc</kbd><span>Close modal / cancel selection</span>
      </div>
      <div style="margin-top:16px;padding-top:12px;border-top:1px solid var(--border-light)">
        <div class="dash-chart-title">🔔 Notifications</div>
        <p style="font-size:0.78rem;color:var(--text-secondary);margin-bottom:8px">Get browser alerts for overdue and upcoming tasks</p>
        <button class="btn btn-primary btn-sm" onclick="Notifications.requestPermission()">Enable Notifications</button>
      </div>
      <div style="margin-top:16px;padding-top:12px;border-top:1px solid var(--border-light)">
        <button class="btn btn-danger btn-sm" onclick="if(confirm('Reset all data?')){localStorage.removeItem('${Store.LS_KEY}');location.reload();}">🔄 Reset All Data</button>
      </div>
    `);
  }
};

