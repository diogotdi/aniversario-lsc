const BulkActions = {
  selected: new Set(),
  active: false,
  toggle(id) {
    if (this.selected.has(id)) this.selected.delete(id); else this.selected.add(id);
    this.updateUI();
  },
  updateUI() {
    this.active = this.selected.size > 0;
    const bar = $('#bulkBar');
    bar.classList.toggle('active', this.active);
    $('#taskListContainer').classList.toggle('bulk-mode', this.active);
    if (this.active) $('#bulkCount').textContent = `${this.selected.size} selected`;
    $$('.task-select').forEach(el => el.classList.toggle('checked', this.selected.has(el.dataset.id)));
  },
  setStatus(status) {
    this.selected.forEach(id => Store.updateTask(id, 'status', status));
    showToast(`${this.selected.size} tasks → ${status}`);
    this.clearSelection();
    TaskList.render();
  },
  clearSelection() {
    this.selected.clear();
    this.updateUI();
  }
};

