const Calendar = {
  year: 2026, month: 10,
  render() { this.renderHeader(); this.renderGrid(); },
  renderHeader() {
    const mn=['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
    $('#calendarHeader').innerHTML = `<div class="calendar-nav"><button onclick="Calendar.prev()">◀</button></div>
      <div class="calendar-title">${mn[this.month]} ${this.year}</div>
      <div class="calendar-nav"><button onclick="Calendar.next()">▶</button><button onclick="Calendar.goToday()" style="font-size:0.68rem;width:auto;padding:0 8px">Today</button></div>`;
  },
  renderGrid() {
    const dn=['Seg','Ter','Qua','Qui','Sex','Sáb','Dom'];
    let html = dn.map(d=>`<div class="calendar-day-name">${d}</div>`).join('');
    const first = new Date(this.year,this.month,1);
    let sd = first.getDay()-1; if(sd<0)sd=6;
    const dim = new Date(this.year,this.month+1,0).getDate();
    const today = new Date().toISOString().slice(0,10);
    const tm = {};
    Store.tasks.forEach(t=>{if(!t.dueDate)return;if(!tm[t.dueDate])tm[t.dueDate]=[];tm[t.dueDate].push(t);});
    const pd = new Date(this.year,this.month,0).getDate();
    for(let i=sd-1;i>=0;i--) html+=`<div class="calendar-cell other-month"><div class="calendar-date">${pd-i}</div></div>`;
    for(let d=1;d<=dim;d++) {
      const iso=`${this.year}-${String(this.month+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
      const dt=tm[iso]||[];
      html+=`<div class="calendar-cell${iso===today?' today':''}" onclick="Calendar.showDay('${iso}')"><div class="calendar-date">${d}</div>`;
      dt.slice(0,3).forEach(t=>{const s=Store.getSection(t.sectionId);html+=`<div class="calendar-task-dot" style="background:${s?.color||'#999'}" onclick="event.stopPropagation();TaskDetail.open('${t.id}')">${escHtml(t.name)}</div>`;});
      if(dt.length>3) html+=`<div class="calendar-more">+${dt.length-3} more</div>`;
      html+='</div>';
    }
    const rem=(7-(sd+dim)%7)%7;
    for(let i=1;i<=rem;i++) html+=`<div class="calendar-cell other-month"><div class="calendar-date">${i}</div></div>`;
    $('#calendarGrid').innerHTML = html;
  },
  prev() { this.month--; if(this.month<0){this.month=11;this.year--;} this.render(); },
  next() { this.month++; if(this.month>11){this.month=0;this.year++;} this.render(); },
  goToday() { const n=new Date(); this.year=n.getFullYear(); this.month=n.getMonth(); this.render(); },
  showDay(iso) {
    const tasks=Store.tasks.filter(t=>t.dueDate===iso);
    if(!tasks.length){showToast(`No tasks on ${formatDate(iso)}`);return;}
    let html=tasks.map(t=>{const s=Store.getSection(t.sectionId);return`<div class="task-card" onclick="Modal.close();setTimeout(()=>TaskDetail.open('${t.id}'),200)"><div class="task-check ${t.status==='Done'?'done':''}"></div><div class="task-info"><div class="task-title">${escHtml(t.name)}</div><div class="task-meta"><span class="tag-badge" style="background:${s?.color||'#999'};color:white">${s?.name||''}</span></div></div></div>`;}).join('');
    Modal.open(`Tasks — ${formatDate(iso)}`, html);
  }
};

